#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<USAGE
Usage:
  ./delete_old_files --date DD-MM-YYYY [--time HH:MM:SS] [--dry-run]
  ./delete_old_files [NAME_OR_GLOB ...] DD-MM-YYYY [HH:MM:SS] [--dry-run]

Deletes regular files in this outputs directory, recursively, whose modification
time is on or before DD-MM-YYYY HH:MM:SS in local time. If --time is omitted,
it defaults to 23:59:59, deleting all files modified on or before DD-MM-YYYY.
If one or more NAME_OR_GLOB filters are supplied, only matching basenames are
deleted. Quote glob patterns such as '*checkpoint*' if you want the script to
receive the pattern literally. The script itself is never deleted.

Examples:
  ./delete_old_files --date 12-05-2026
  ./delete_old_files --date 12-05-2026 --time 21:18:00
  ./delete_old_files --date 12-05-2026 --dry-run
  ./delete_old_files '*checkpoint*' 12-05-2026
  ./delete_old_files file1.nc file2.nc 12-05-2026 21:18:00
USAGE
}

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
script_path="$script_dir/$(basename -- "${BASH_SOURCE[0]}")"
date_arg=""
time_arg="23:59:59"
dry_run=false
name_filters=()
positionals=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --date)
            [[ $# -ge 2 ]] || { echo "error: --date requires DD-MM-YYYY" >&2; exit 2; }
            date_arg="$2"
            shift 2
            ;;
        --time)
            [[ $# -ge 2 ]] || { echo "error: --time requires HH:MM:SS" >&2; exit 2; }
            time_arg="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            positionals+=("$1")
            shift
            ;;
    esac
done

if [[ ${#positionals[@]} -gt 0 ]]; then
    last_index=$((${#positionals[@]} - 1))

    if [[ -z "$date_arg" && "${positionals[$last_index]}" =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
        time_arg="${positionals[$last_index]}"
        unset 'positionals[$last_index]'
        positionals=("${positionals[@]}")
        last_index=$((${#positionals[@]} - 1))
    fi

    if [[ -z "$date_arg" ]]; then
        [[ ${#positionals[@]} -gt 0 ]] || { echo "error: missing date argument" >&2; usage >&2; exit 2; }
        date_arg="${positionals[$last_index]}"
        unset 'positionals[$last_index]'
        positionals=("${positionals[@]}")
    fi

    if [[ ${#positionals[@]} -gt 0 ]]; then
        name_filters=("${positionals[@]}")
    fi
fi

[[ -n "$date_arg" ]] || { echo "error: missing --date DD-MM-YYYY or positional date" >&2; usage >&2; exit 2; }

if [[ ! "$date_arg" =~ ^([0-9]{2})-([0-9]{2})-([0-9]{4})$ ]]; then
    echo "error: date must be DD-MM-YYYY, for example 12-05-2026" >&2
    exit 2
fi

day="${BASH_REMATCH[1]}"
month="${BASH_REMATCH[2]}"
year="${BASH_REMATCH[3]}"
cutoff_iso="$year-$month-$day"

if [[ ! "$time_arg" =~ ^([0-9]{2}):([0-9]{2}):([0-9]{2})$ ]]; then
    echo "error: time must be HH:MM:SS, for example 21:18:00" >&2
    exit 2
fi

cutoff_timestamp="$cutoff_iso $time_arg"

validated="$(date -d "$cutoff_iso" +%Y-%m-%d 2>/dev/null)" || {
    echo "error: invalid date: $date_arg" >&2
    exit 2
}

if [[ "$validated" != "$cutoff_iso" ]]; then
    echo "error: invalid date: $date_arg" >&2
    exit 2
fi

validated_time="$(date -d "$cutoff_timestamp" +%H:%M:%S 2>/dev/null)" || {
    echo "error: invalid time: $time_arg" >&2
    exit 2
}

if [[ "$validated_time" != "$time_arg" ]]; then
    echo "error: invalid time: $time_arg" >&2
    exit 2
fi

build_find_command() {
    local -n cmd_ref=$1
    cmd_ref=(
        find "$script_dir"
        -type f
        ! -samefile "$script_path"
    )

    if [[ ${#name_filters[@]} -gt 0 ]]; then
        cmd_ref+=( '(' )
        local i
        for i in "${!name_filters[@]}"; do
            if [[ $i -gt 0 ]]; then
                cmd_ref+=( -o )
            fi
            cmd_ref+=( -name "${name_filters[$i]}" )
        done
        cmd_ref+=( ')' )
    fi

    cmd_ref+=(
        ! -newermt "$cutoff_timestamp"
        -print
    )
}

if $dry_run; then
    echo "Would delete files in $script_dir modified on or before $date_arg $time_arg local time:"
    if [[ ${#name_filters[@]} -gt 0 ]]; then
        printf 'Matching filters: %s\n' "${name_filters[*]}"
    fi
    build_find_command find_cmd
    "${find_cmd[@]}"
else
    echo "Deleting files in $script_dir modified on or before $date_arg $time_arg local time..."
    if [[ ${#name_filters[@]} -gt 0 ]]; then
        printf 'Matching filters: %s\n' "${name_filters[*]}"
    fi
    build_find_command find_cmd
    find_cmd+=( -delete )
    "${find_cmd[@]}"
fi
