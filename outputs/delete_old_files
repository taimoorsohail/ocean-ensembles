#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  ./delete_old_files --date DD-MM-YYYY [--dry-run]

Deletes regular files in this outputs directory, recursively, whose modification
date is on or before DD-MM-YYYY. The script itself is never deleted.

Examples:
  ./delete_old_files --date 12-05-2026
  ./delete_old_files --date 12-05-2026 --dry-run
EOF
}

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
script_path="$script_dir/$(basename -- "${BASH_SOURCE[0]}")"
date_arg=""
dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --date)
            [[ $# -ge 2 ]] || { echo "error: --date requires DD-MM-YYYY" >&2; exit 2; }
            date_arg="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

[[ -n "$date_arg" ]] || { echo "error: missing --date DD-MM-YYYY" >&2; usage >&2; exit 2; }

if [[ ! "$date_arg" =~ ^([0-9]{2})-([0-9]{2})-([0-9]{4})$ ]]; then
    echo "error: date must be DD-MM-YYYY, for example 12-05-2026" >&2
    exit 2
fi

day="${BASH_REMATCH[1]}"
month="${BASH_REMATCH[2]}"
year="${BASH_REMATCH[3]}"
cutoff_iso="$year-$month-$day"

validated="$(date -d "$cutoff_iso" +%Y-%m-%d 2>/dev/null)" || {
    echo "error: invalid date: $date_arg" >&2
    exit 2
}

if [[ "$validated" != "$cutoff_iso" ]]; then
    echo "error: invalid date: $date_arg" >&2
    exit 2
fi

cutoff_next_day="$(date -d "$cutoff_iso + 1 day" +%Y-%m-%d)"

if $dry_run; then
    echo "Would delete files in $script_dir modified on or before $date_arg:"
    find "$script_dir" \
        -type f \
        ! -samefile "$script_path" \
        ! -newermt "$cutoff_next_day" \
        -print
else
    echo "Deleting files in $script_dir modified on or before $date_arg..."
    find "$script_dir" \
        -type f \
        ! -samefile "$script_path" \
        ! -newermt "$cutoff_next_day" \
        -print \
        -delete
fi
